{
  "name": "pi-mini",
  "version": "0.0.0",
  "description": "A minimal shell-style terminal chat interface for Pi.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Kostiantyn Kushnir",
    "email": "chpock@gmail.com"
  },
  "homepage": "https://github.com/chpock/pi-mini#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chpock/pi-mini.git"
  },
  "bugs": {
    "url": "https://github.com/chpock/pi-mini/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "terminal",
    "tui",
    "chat",
    "minimal-ui"
  ],
  "files": ["src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "dev": "pi --no-session --extension .",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
